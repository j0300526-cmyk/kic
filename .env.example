# Backend
ALPHAMIX_AGENT_MODE=mock
ALPHAMIX_DATABASE_URL=sqlite:///./alphamix.db
ALPHAMIX_CORS_ORIGINS=http://localhost:5173

# Optional LLM adapter. Mock mode needs no credentials.
ALPHAMIX_LLM_MODEL=
ALPHAMIX_LLM_API_KEY=
ALPHAMIX_LLM_API_URL=
ALPHAMIX_MARKET_DATA_CACHE_TTL_SECONDS=60
ALPHAMIX_MARKET_DATA_TIMEOUT_SECONDS=6
ALPHAMIX_NEWS_DATA_CACHE_TTL_SECONDS=900
ALPHAMIX_NEWS_DATA_TIMEOUT_SECONDS=12

# Frontend (copy the relevant value to frontend/.env.local if needed)
VITE_API_BASE_URL=http://localhost:8000/api/v1

